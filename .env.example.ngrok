# ngrok Agent CLI Quickstart - Environment Variables

# Seu ngrok authentication token
# Obtém em: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=3IU7zmxRvf4yw7MfrsweBCGKRAS_2ZYJoG9MBexS9AK2Ga2Fb

# Seu domínio ngrok reservado
NGROK_DOMAIN=mustiness-bootleg-subzero.ngrok-free.dev

# Google OAuth Configuration
# Crie uma aplicação em: https://console.cloud.google.com/
# Tipo: OAuth 2.0 Client ID (Web application)
# Authorized redirect URIs: https://mustiness-bootleg-subzero.ngrok-free.dev/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here
